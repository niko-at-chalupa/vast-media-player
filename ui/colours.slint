export global Theme {
    in-out property <color> background: #151217;
    in-out property <color> text: #ffffff;
    in-out property <color> secondary: #c084f5;
    in-out property <color> primary: #ddb9f8;
    in-out property <color> background-2: #2a1f2e;
    in-out property <color> text-2: #696969;
}
