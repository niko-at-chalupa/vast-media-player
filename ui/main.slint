import { Theme } from "./colours.slint";
import "./fonts/xanh_mono/XanhMono-Regular.ttf";
import "./fonts/xanh_mono/XanhMono-Italic.ttf";
import "./fonts/roboto_mono/RobotoMono-Italic-VariableFont_wght.ttf";
import "./fonts/roboto_mono/RobotoMono-VariableFont_wght.ttf";
import { Player } from "./player.slint";
import { StatusBar } from "./status_bar.slint";
import { Home } from "./home.slint";
import { PlayerData } from "./player.slint";
export { PlayerData }
import { StatusBarData } from "./status_bar.slint";
export { StatusBarData }
import { State, AppState } from "./state.slint";

export component MainWindow inherits Window {
    width: 320px;
    height: 240px;
    title: "Vast";
    default-font-family: "Roboto Mono";
    background: Theme.background;

    property <State> displayed-screen: State.Home;
    in-out property <State> active-screen: AppState.state;

    property <bool> fading: false;

    property <bool> should-show-lyrics-in-status-bar: PlayerData.has-lyrics && root.active-screen != State.Player;
    changed should-show-lyrics-in-status-bar => {
        StatusBarData.show-status-bar-lyrics = root.should-show-lyrics-in-status-bar;
    }

    changed active-screen => {
        if (self.active-screen != self.displayed-screen) {
            self.fading = true;
        }
    }

    forward-focus: main-focus-scope;

    main-focus-scope := FocusScope {
        key-pressed(event) => {
            if (root.active-screen == State.Home) {
                if (event.text == Key.S || event.text == Key.DownArrow || event.text == "s") {
                    home-layer.navigate-down();
                    return accept;
                }
                if (event.text == Key.W || event.text == Key.UpArrow || event.text == "w") {
                    home-layer.navigate-up();
                    return accept;
                }
                if (event.text == Key.F || event.text == " " || event.text == Key.Return || event.text == "f") {
                    home-layer.activate-selected();
                    return accept;
                }
            } else if (root.active-screen == State.Player) {
                if (event.text == Key.Escape) {
                    AppState.state = State.Home;
                    return accept;
                }
            }

            if (root.active-screen == State.Player) {
                if event.text == Key.Escape {
                    // Looks weird, but it's better inline...
                    AppState.state = State.Home;
                    return accept;
                }
            }

            return reject;
        }
    }

    VerticalLayout {
        StatusBar {}

        Rectangle {
            background: Theme.background;
            width: root.width;
            height: root.height - 18px;

            player-layer := Player {
                width: root.width;
                height: parent.height;
                opacity: root.fading ? 0.0 : 1.0;
                visible: root.displayed-screen == State.Player;

                animate opacity {
                    duration: 150ms;
                    easing: ease-in-out;
                }
            }

            home-layer := Home {
                width: root.width;
                height: parent.height;
                opacity: root.fading ? 0.0 : 1.0;
                visible: root.displayed-screen == State.Home;

                animate opacity {
                    duration: 150ms;
                    easing: ease-in-out;
                }
            }
        }
    }

    swap-timer := Timer {
        interval: 150ms;
        running: root.fading;
        triggered => {
            root.displayed-screen = root.active-screen;
            root.fading = false;
        }
    }
}